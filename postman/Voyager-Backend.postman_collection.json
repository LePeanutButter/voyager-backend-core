    {
      "name": "02 — Registro y autenticación",
      "description": "Sin Bearer. Login guarda JWT en variables de colección.",
      "item": [
        {
          "name": "Check username",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/users/check-username?username={{testUsername}}",
            "description": ""
          },
          "response": []
        },
        {
          "name": "Check email",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/users/check-email?email={{testUsername}}@example.com",
            "description": ""
          },
          "response": []
        },
        {
          "name": "Registrar (POST /users)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/users",
            "description": "Ajusta `testUsername` en variables si el usuario ya existe.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{testUsername}}\",\n  \"email\": \"{{testUsername}}@example.com\",\n  \"password\": \"{{testPassword}}\",\n  \"firstName\": \"Postman\",\n  \"lastName\": \"Tester\",\n  \"phoneNumber\": \"+573001112233\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "try {",
                  "  const j = pm.response.json();",
                  "  if ((pm.response.code === 200 || pm.response.code === 201) && j.data && j.data.id) {",
                  "    pm.collectionVariables.set('currentUserId', String(j.data.id));",
                  "  }",
                  "} catch (e) { console.warn(e); }"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/users/login",
            "description": "Guarda `accessToken` y `currentUserId`.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usernameOrEmail\": \"{{testUsername}}\",\n  \"password\": \"{{testPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "try {",
                  "  const j = pm.response.json();",
                  "  if (pm.response.code === 200 && j.data && j.data.token) {",
                  "    pm.collectionVariables.set('accessToken', j.data.token);",
                  "    pm.collectionVariables.set('currentUserId', String(j.data.id));",
                  "    console.log('Variables: accessToken, currentUserId');",
                  "  }",
                  "} catch (e) { console.warn(e); }"
                ],
                "type": "text/javascript"
              }
            }
